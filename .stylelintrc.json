{
    "extends": [
        "stylelint-config-standard",
        "stylelint-scss"
    ],
    "plugins": [
        "stylelint-order"
    ],
    "rules": {
        "order/properties-alphabetical-order": true,
        "indentation": 2,
        "string-quotes": "single",
        "color-hex-case": "lower",
        "selector-max-compound-selectors": 2,
        "selector-max-id": 0,
        "declaration-no-important": true,
        "color-named": "never"
    }
}